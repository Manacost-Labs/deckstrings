{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Manacost-Labs/deckstrings/spec/export.schema.json",
  "title": "Parsed Hearthstone clipboard export",
  "type": "object",
  "additionalProperties": false,
  "required": ["deck", "deckstring", "metadata"],
  "properties": {
    "deck": {
      "$ref": "deck.schema.json"
    },
    "deckstring": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comments"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
