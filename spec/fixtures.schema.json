{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Manacost-Labs/hearthstone-deckstrings/spec/fixtures.schema.json",
  "title": "Cross-language Hearthstone deckstring fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "valid"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "valid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "deckstring", "deck"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "deckstring": {
            "type": "string",
            "minLength": 1
          },
          "canonicalDeckstring": {
            "type": "string",
            "minLength": 1
          },
          "deck": {
            "$ref": "deck.schema.json"
          }
        }
      }
    }
  }
}
