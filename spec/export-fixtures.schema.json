{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Manacost-Labs/hearthstone-deckstrings/spec/export-fixtures.schema.json",
  "title": "Cross-language Hearthstone clipboard export fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "valid", "invalid", "resolver"],
  "properties": {
    "$schema": { "type": "string" },
    "valid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "text", "parsed", "formatted"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "parsed": { "$ref": "export.schema.json" },
          "formatted": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invalid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "text", "errorCode"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "errorCode": {
            "type": "string",
            "enum": ["invalid_input", "invalid_base64"]
          }
        }
      }
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "invalid"],
      "properties": {
        "valid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "deck", "metadata", "cards", "formatted"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "deck": { "$ref": "deck.schema.json" },
              "metadata": { "$ref": "export.schema.json#/properties/metadata" },
              "cards": { "$ref": "#/$defs/resolverCards" },
              "formatted": { "type": "string", "minLength": 1 }
            }
          }
        },
        "invalid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "deck", "cards", "errorCode"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "deck": { "$ref": "deck.schema.json" },
              "cards": { "$ref": "#/$defs/resolverCards" },
              "errorCode": { "const": "invalid_input" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "resolverCards": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "cost": { "type": "integer" }
            }
          }
        ]
      }
    }
  }
}
