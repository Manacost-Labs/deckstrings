{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Manacost-Labs/deckstrings/spec/api-fixtures.schema.json",
  "title": "Cross-language validation and canonicalization fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "canonicalize", "validate"],
  "properties": {
    "$schema": { "type": "string" },
    "canonicalize": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "deck"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "deck": { "type": "object" },
          "expectedDeck": { "$ref": "deck.schema.json" },
          "errorCode": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["expectedDeck"] },
          { "required": ["errorCode"] }
        ]
      }
    },
    "validate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "deck", "valid", "errors"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "deck": { "type": "object" },
          "valid": { "type": "boolean" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "path"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "path": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
