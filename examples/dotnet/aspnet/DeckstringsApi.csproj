<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DeckstringsPackageVersion Condition="'$(DeckstringsPackageVersion)' == ''">1.0.0</DeckstringsPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ManacostLabs.Deckstrings" Version="$(DeckstringsPackageVersion)" />
  </ItemGroup>
</Project>
