{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"rootDir": "./src",
		"outDir": "./dist/types"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["test", "dist", "node_modules"]
}
