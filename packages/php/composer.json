{
  "name": "manacost-labs/hearthstone-deckstrings",
  "description": "Dependency-free Hearthstone deckstring codec, validation, and clipboard export library",
  "type": "library",
  "license": "ISC",
  "homepage": "https://github.com/Manacost-Labs/hearthstone-deckstrings",
  "keywords": [
    "hearthstone",
    "deckstrings"
  ],
  "require": {
    "php": ">=8.2 <8.6"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "ManacostLabs\\Deckstrings\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ManacostLabs\\Deckstrings\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test:compatibility": "@php tests/compatibility.php",
    "test:unit": "phpunit",
    "test": [
      "@test:compatibility",
      "@test:unit"
    ],
    "analyse": "phpstan analyse --no-progress",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "allow-plugins": false,
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/.phpunit.cache",
      "/composer.lock",
      "/phpstan.neon.dist",
      "/phpunit.xml.dist",
      "/tests",
      "/vendor"
    ]
  },
  "support": {
    "issues": "https://github.com/Manacost-Labs/hearthstone-deckstrings/issues",
    "source": "https://github.com/Manacost-Labs/hearthstone-deckstrings"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
