<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DeckstringsPackageSource Condition="'$(DeckstringsPackageSource)' == ''">../../src/ManacostLabs.Deckstrings/bin/Release</DeckstringsPackageSource>
    <DeckstringsPackageVersion Condition="'$(DeckstringsPackageVersion)' == ''">1.0.0</DeckstringsPackageVersion>
    <RestoreSources>$(DeckstringsPackageSource)</RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ManacostLabs.Deckstrings" Version="$(DeckstringsPackageVersion)" />
  </ItemGroup>
</Project>
